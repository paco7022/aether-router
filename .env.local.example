# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy fallback if the project still uses anon keys instead of publishable keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public Cloudflare URLs
NEXT_PUBLIC_SITE_URL=https://router-cloud.aether-ai.dev
NEXT_PUBLIC_AETHER_API_BASE_URL=https://api.aether-ai.dev/v1
# Comma-separated list of allowed CORS origins (optional, overrides SITE_URL)
ALLOWED_ORIGINS=https://router-cloud.aether-ai.dev,https://router.aether-ai.dev

# Cost controls
AETHER_FREE_INCLUDED_USAGE_ENABLED=true
AETHER_FREE_PROMOS_ENABLED=false
# Temporary promo flag: when "true", db/ (DLab) models route fully free +
# unlimited (no credits, no premium pool, no daily cap; plan context cap still
# applies), independent of AETHER_FREE_PROMOS_ENABLED. Used for short-lived
# donated DLab keys. Leave false in normal operation.
DLAB_FREE_UNLIMITED=false

# Admin emails (comma-separated, defaults to hardcoded list if not set)
# ADMIN_EMAILS=admin@example.com

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Providers (all API keys are REQUIRED — no defaults)
AIRFORCE_API_KEY=your-airforce-api-key

GEMINI_CLI_URL=https://api.aether-ai.dev/v1
GEMINI_CLI_API_KEY=your-gemini-cli-api-key

TROLLLLM_BASE_URL=https://chat.trollllm.xyz/v1
TROLLLLM_API_KEY=your-trolllm-api-key

ANTIGRAVITY_BASE_URL=https://api.aether-ai.dev/v1
ANTIGRAVITY_API_KEY=your-antigravity-api-key

WEBPROXY_BASE_URL=https://api1.aether-ai.dev/v1
WEBPROXY_API_KEY=your-webproxy-api-key

NANO_API_KEY=your-nano-gpt-api-key
NANO_BASE_URL=https://nano-gpt.com/api/v1

# DeepSeek official API (OpenAI-compatible), pay-as-you-go per-token.
# Context caching is automatic (prefix-based) and billed at the model's
# cost_per_m_cache_read rate via usage.prompt_tokens_details.cached_tokens.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenRouter attribution
OPENROUTER_REFERER=https://router-cloud.aether-ai.dev

# Hapuppy (h/)
HAPUPPY_BASE_URL=https://api.hapuppy.com/v1
HAPUPPY_API_KEY=your-hapuppy-api-key

# Gameron (gm/) — primary + secondary for auto key rotation on 401/403
GAMERON_BASE_URL=https://api.gameron.me/v1
GAMERON_PRIMARY_KEY=your-gameron-primary-key
GAMERON_SECONDARY_KEY=your-gameron-secondary-key

# rout.my (rt/) — premium OpenAI-compatible reseller
# ROUTMY_API_KEY accepts one key or a comma-separated pool; a key is picked at
# random per request to spread load and reduce upstream 429s.
ROUTMY_BASE_URL=https://api.rout.my/v1
ROUTMY_API_KEY=your-routmy-api-key[,second-key,...]

# sh00t.host (sh/) — premium OpenAI-compatible reseller (Claude Opus, GPT-5.5,
# Gemini 3.x, DeepSeek V4, GLM-5.2, Kimi K2.7, MiniMax M-3). Isolated key.
# SHOOT_API_KEY accepts one key or a comma-separated pool; a key is picked at
# random per request.
SHOOT_BASE_URL=https://sh00t.host/v1
SHOOT_API_KEY=your-shoot-api-key[,second-key,...]

# Orbit (or/) — premium reseller fronting Amazon Kiro Pro (Anthropic-native endpoint).
# ORBIT_API_KEY accepts one key or a comma-separated pool. A key is picked at
# random per request; on a per-key 429/5xx the retry fails over to a different
# key. Add more keys here to scale upstream throughput (one Kiro account can't
# sustain high volume on its own).
ORBIT_BASE_URL=https://api.orbit-provider.com/api/provider/agy
ORBIT_API_KEY=your-orbit-api-key[,second-key,...]
# or/ free + unlimited for everyone (ON by default). Routes Orbit as zero-cost:
# no credits / premium pool, only a context cap (32k free, 128k paid). Set to
# "false" to revert or/ to normal premium-pool billing.
ORBIT_FREE_UNLIMITED=true

# Shared secret for the Discord bot to sync server-booster status via
# POST /api/v1/booster (Authorization: Bearer <secret>). Boosters get 10k
# permanent credits per calendar month (granted by a daily idempotent cron).
DISCORD_BOT_SECRET=your-long-random-bot-secret

# CSAM moderation (src/lib/content-moderation.ts).
# Primary backend defaults to Hapuppy's beta host (free omni-moderation,
# OpenAI-compatible). Use the `beta.` host — `api.hapuppy.com` returns 401.
# If unset, falls back to HAPUPPY_API_KEY. OpenAI direct is an automatic
# secondary fallback when OPENAI_API_KEY is set (also free, but low-tier orgs
# get 429-throttled). Gate fails open if every backend errors.
MODERATION_BASE_URL=https://beta.hapuppy.com/v1
MODERATION_API_KEY=your-hapuppy-or-openai-key
OPENAI_API_KEY=your-openai-key-optional-fallback
